{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node16",
    "allowJs": true,
    "lib": ["es2023"],
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "moduleResolution": "node16",
    "removeComments": true,
    "noImplicitAny": false,
    "strict": false,
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules"]
}
